# Postgres for the agent's own records (schema: remit). Can share a
# Neon database with other agents; schemas do not collide.
DATABASE_URL=postgres://remit:remit@localhost:5432/remit

# Go ledger service (stand-in accounts-receivable system of record).
LEDGER_URL=http://localhost:8090
LEDGER_TOKEN=change-me

# Review page.
REVIEW_PASSWORD=change-me
PORT=3000

# Drafting model, provider:model. Blank/keyless = deterministic baseline.
DRAFT_MODEL=baseline:rules
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OSS_BASE_URL=https://api.groq.com/openai/v1

# Per-run model budget in USD.
REMIT_BUDGET_USD=1
