{
  "name": "remit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Remit: a B2B accounts-receivable agent that gets invoices paid sooner, inside compliance rails, measured in cash collected.",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.ts",
    "seed": "tsx scripts/seed.ts",
    "sweep": "tsx src/cli.ts sweep",
    "eval": "tsx src/cli.ts eval",
    "serve": "tsx src/cli.ts serve"
  },
  "dependencies": { "pg": "^8.13.1" },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
